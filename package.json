{
  "name": "discord-notify",
  "version": "0.5.0",
  "description": "OpenCode plugin that sends Discord webhook embeds when a session finishes, asks for permission, or asks a question",
  "type": "module",
  "license": "MIT",
  "keywords": ["opencode", "opencode-plugin", "discord", "webhook", "notifications"],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": ["src", "scripts"],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
